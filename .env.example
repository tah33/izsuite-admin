# Copy to .env and fill in APP_KEY. See README.md for the quick start.
#
# Hostnames here are Docker service names, not localhost. Inside a container
# 127.0.0.1 is the container itself, not the database.

APP_NAME=izSuite
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Used only by docker-compose.prod.yml. Kept separate from APP_DEBUG so a local
# development .env cannot accidentally enable debug output in production.
PRODUCTION_APP_DEBUG=false
APP_URL=http://localhost:8000

# URL of the Nuxt frontend. Used for CORS, mail links and redirects.
FRONTEND_URL=https://izsuite.com

# Host port the app container publishes on, bound to 127.0.0.1 only.
# Change if something else already owns 8000.
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# MySQL reads these only when it initialises an empty data directory. Changing
# them later has no effect until `docker compose down -v`, which destroys the
# database — so decide credentials before the first `up`.
#
# DB_USERNAME must NOT be `root`: MySQL's entrypoint refuses to create a user
# that already exists, and the container fails to start.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=izsuite
DB_USERNAME=izsuite
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret
DB_TIMEZONE=+00:00

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Redis is already running, so use it. The `database` driver turns every cache
# read, session lookup and queue poll into a MySQL round trip.
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# Leading dot shares the session cookie across izsuite.com and
# admin.izsuite.com — required for Sanctum SPA auth. Leave empty for local.
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=

# ── Mail ──────────────────────────────────────────────────────────────────────
# `log` writes messages to storage/logs instead of sending. Point at a relay
# (Resend, Postmark, SES, Mailgun) for real delivery — a fresh server IP has no
# sending reputation, and Hetzner blocks outbound port 25 by default.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@izsuite.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Broadcasting ──────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_VERIFY_SSL=true

# ── Storage ───────────────────────────────────────────────────────────────────
# `local` writes to storage/app, which is a named volume in production.
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Businesses' files (attachments, item images, digital files, logos): `local`
# keeps them on this server, `spaces` in DigitalOcean Spaces. Files already
# stored keep working after a switch; `php artisan files:move --to=spaces` (or
# --to=local) moves them across. See config/files.php.
FILES_DISK=local

# DigitalOcean Spaces, for FILES_DISK=spaces. The endpoint follows the region
# unless set. DO_SPACES_URL is where public files are read from - the Space's
# CDN address, for example - and DO_SPACES_ROOT a folder that keeps this
# environment's files apart when several share one Space.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=
DO_SPACES_URL=
DO_SPACES_ROOT=

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
LINKEDIN_CLIENT_ID=

# ── AI HTTP client ────────────────────────────────────────────────────────────
AI_HTTP_VERIFY_SSL=true
AI_HTTP_RETRIES=3
AI_HTTP_RETRY_DELAY_MS=1200

VITE_APP_NAME="${APP_NAME}"

# Octane keeps the framework booted across requests (only the production
# target runs it; dev stays on `php artisan serve` for instant reloads).
# frankenphp is the only Octane runtime installed in the image.
OCTANE_SERVER=frankenphp
